{
  "name": "my-mail",
  "version": "0.1.0",
  "description": "A personal, local-first email client with a unified inbox, smart sorting and AI summaries.",
  "main": "./out/main/index.js",
  "author": "sellermatrix",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "*",
    "@types/mailparser": "*",
    "@types/node": "^22",
    "@types/nodemailer": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.sellermatrix.mymail",
    "productName": "My Mail",
    "files": ["out/**/*"],
    "mac": { "category": "public.app-category.productivity" }
  }
}
